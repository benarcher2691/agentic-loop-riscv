{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "small_model": "openrouter/z-ai/glm-5.3-flash",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "make": "allow",
      "make check": "allow",
      "make sim": "allow",
      "make lint": "allow",
      "make synth": "allow",
      "make pnr": "allow",
      "make stat": "allow",
      "make clean": "allow",
      "make -s *": "allow",
      "make prog": "deny",
      "make uart": "deny",
      "make hwtest": "deny",
