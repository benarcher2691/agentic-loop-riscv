      "iceprog*": "deny",
      "python3 tools/uart.py*": "deny",
      "iverilog *": "allow",
      "vvp *": "allow",
      "yosys *": "allow",
      "nextpnr-ice40 *": "allow",
      "icepack *": "allow",
      "icetime *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
